{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "generate": {
      "cache": true,
      "inputs": ["prisma/schema.prisma"]
    },
    "dev": {
      "dependsOn": ["^generate"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^generate", "^build"],
      "outputs": [".next/**", "dist/**"]
    }
  }
}